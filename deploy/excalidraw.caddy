excalidraw.princechaudhary.xyz {
	encode zstd gzip

	handle /api/* {
		reverse_proxy excalidraw-server:4000
	}

	handle /ws* {
		reverse_proxy excalidraw-server:4000
	}

	handle {
		root * /srv/sites/excalidraw.princechaudhary.xyz/current
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
